<?xml version="1.0" encoding="UTF-8"?>
<!-- Only needed if the site is hosted on Microsoft IIS. IIS refuses to serve file types it
     doesn't recognize, so this registers .pmtiles. Apache and nginx need no changes. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".pmtiles" />
      <mimeMap fileExtension=".pmtiles" mimeType="application/octet-stream" />
    </staticContent>
  </system.webServer>
</configuration>
